{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ALJWHARAH ONE",
  "version": "0.2.0",
  "identifier": "one.aljwharah.app",
  "build": {
    "frontendDist": "../../../dist",
    "devUrl": "http://127.0.0.1:8080",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ALJWHARAH ONE",
        "width": 1280,
        "height": 800,
        "minWidth": 880,
        "minHeight": 560,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "Commander",
        "url": "/overlay",
        "width": 560,
        "height": 240,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true,
        "visible": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://grok.com; connect-src 'self' https://grok.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; object-src 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFRkUwMEFMOENDNzE0NgpSV1FnOHlVLG5CZVFrK1ZlcmlmeS1vbmx5LXNpZ25lZC11cGRhdGVzCg==",
      "endpoints": ["https://releases.aljwharah.one/{{target}}/{{arch}}/{{current_version}}"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
