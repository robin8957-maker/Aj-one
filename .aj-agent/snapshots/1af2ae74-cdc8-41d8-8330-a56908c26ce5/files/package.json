    "build:dev": "vite build --mode development",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'scripts/**/*.test.mjs' && node --experimental-strip-types --test tests/runtime.test.ts tests/v2-engines.test.ts tests/v3-governed.test.ts tests/v4-hardening.test.ts tests/workstation.test.ts tests/work.test.ts tests/connections.test.ts tests/sandbox.test.ts tests/hardening-8.test.ts tests/os-next.test.ts tests/platform-6.test.ts tests/governance.test.ts tests/hardening-next.test.ts tests/negotiate.test.ts tests/indexer.test.ts tests/rewind-self.test.ts tests/phase5.test.ts tests/phase6.test.ts tests/overlay.test.ts tests/jail-pool.test.ts tests/tauri-ipc.test.ts tests/leftover.test.ts tests/phase7.test.ts tests/phase8.test.ts tests/northstar-hardening.test.ts tests/secret-cleanup.test.ts tests/embeddings.test.ts tests/model-selection.test.ts tests/catalog.test.ts tests/lens-extension.test.ts tests/master-contract.test.ts tests/general-engineering.test.ts tests/p0-coder-classes.test.ts tests/p1-ledger-worker-evidence.test.ts tests/p2-isolation-honesty.test.ts tests/p3-security-patch.test.ts tests/p4-daemon-recovery.test.ts tests/p5-acceptance.test.ts",
